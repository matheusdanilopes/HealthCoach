# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# NextAuth — Generate a random secret: openssl rand -base64 32
AUTH_SECRET=your-random-secret-here
AUTH_URL=https://your-app.vercel.app

# Gemini — Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Web Push (VAPID) — Generate with: node -e "require('web-push').generateVAPIDKeys()" | npx --yes web-push generate-vapid-keys
# Or: node -e "const wp=require('web-push');const k=wp.generateVAPIDKeys();console.log(k.publicKey,k.privateKey)"
NEXT_PUBLIC_VAPID_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=admin@your-domain.com
