# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# NextAuth — Generate a random secret: openssl rand -base64 32
AUTH_SECRET=your-random-secret-here
AUTH_URL=https://your-app.vercel.app

# Gemini — Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...

# Groq — Fallback provider used when Gemini fails. Get from https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Optional — overrides the default vision-capable model
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Web Push (VAPID) — Generate with: node -e "require('web-push').generateVAPIDKeys()" | npx json
# Public key goes in Vercel env as NEXT_PUBLIC_ so it's available client-side
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
# Private key is server-only — NEVER expose to client
VAPID_PRIVATE_KEY=your-vapid-private-key-here
# Contact email shown in push headers
VAPID_CONTACT_EMAIL=mailto:admin@your-domain.com

# Vercel Cron secret — random string used to authenticate cron requests
# Generate with: openssl rand -base64 32
CRON_SECRET=your-random-cron-secret-here
